---
// Foto real optimizada (AVIF/WebP/JPG, srcset). Si el archivo no existe aún, muestra un bloque sobrio
// con la descripción de la foto que falta (nunca stock).
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { ruta } from '../lib/datos';

interface Props {
  archivo?: string | null; alt: string; pendiente?: string; class?: string;
  sizes?: string; eager?: boolean; duotono?: boolean; posicion?: string; style?: string;
}
const { archivo, alt, pendiente, class: clase = '', sizes = '100vw', eager = false, duotono = false, posicion, style } = Astro.props;
const fotos = import.meta.glob<{ default: ImageMetadata }>('../assets/fotos/*.{jpg,jpeg,png,webp}');
const clave = archivo ? `../assets/fotos/${archivo}` : '';
const img = clave && fotos[clave] ? (await fotos[clave]()).default : null;
const anchos = img ? [480, 768, 1200, 1920].filter((w) => w <= img.width).concat(img.width < 1920 ? [img.width] : []) : [];
---
{img ? (
  <div class:list={['foto', clase, { duotono }]} style={style}>
    <Picture src={img} alt={alt} formats={['avif', 'webp']} widths={[...new Set(anchos)]} sizes={sizes}
      loading={eager ? 'eager' : 'lazy'} decoding="async" fetchpriority={eager ? 'high' : undefined}
      style={posicion ? `object-position:${posicion}` : undefined} />
  </div>
) : (
  <div class:list={['foto-pendiente', clase]} style={style} role="img" aria-label={alt}>
    <div>
      <img class="iso" src={ruta('/logo/isotipo-blanco.svg')} alt="" width="56" height="56" />
      <p>Foto: {pendiente ?? alt}</p>
    </div>
  </div>
)}
