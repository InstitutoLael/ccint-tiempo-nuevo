---
import '../estilos/tokens.css';
import '../estilos/base.css';
import anton from '../assets/fuentes/anton-latin-400-normal.woff2?url';
import montserrat from '../assets/fuentes/montserrat-latin-500-normal.woff2?url';
import Header from '../componentes/Header.astro';
import Footer from '../componentes/Footer.astro';
import { iglesia, ruta, datosHorario, correo, facebook, instagram, youtube } from '../lib/datos';

interface Props {
  titulo?: string; descripcion: string; og?: 'inicio' | 'visitanos' | 'en-vivo' | 'general';
  sobreNoche?: boolean; noindex?: boolean; schema?: boolean;
}
const { titulo, descripcion, og = 'general', sobreNoche = false, noindex = false, schema = false } = Astro.props;
const tituloCompleto = titulo ? `${titulo} · ${iglesia.nombre.marca}` : iglesia.seo.titulo;
const canonica = new URL(Astro.url.pathname, Astro.site).href;
const ogImagen = new URL(ruta(`/og/${og}.jpg`), Astro.site).href;

const { direccion: d } = iglesia;
const ld = schema && {
  '@context': 'https://schema.org',
  '@type': 'Church',
  name: iglesia.nombre.marca,
  alternateName: iglesia.nombre.legal.valor,
  description: iglesia.seo.descripcion,
  url: new URL(ruta('/'), Astro.site).href,
  logo: new URL(ruta('/logo/logo-completo-color.png'), Astro.site).href,
  ...(correo ? { email: correo } : {}),
  address: { '@type': 'PostalAddress', streetAddress: d.texto, addressLocality: d.comuna, addressRegion: iglesia.nombre.region, addressCountry: 'CL' },
  geo: { '@type': 'GeoCoordinates', latitude: d.lat, longitude: d.lng },
  hasMap: d.mapa_url,
  sameAs: [facebook.url, instagram.url, youtube.url],
  event: iglesia.reuniones.map((r) => ({
    '@type': 'Event',
    name: `${r.nombre} · ${iglesia.nombre.marca}`,
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    location: { '@type': 'Place', name: iglesia.nombre.marca, address: `${d.texto}, ${d.comuna}` },
    eventSchedule: {
      '@type': 'Schedule', repeatFrequency: 'P1W', startTime: r.hora, scheduleTimezone: iglesia.zona_horaria,
      byDay: `https://schema.org/${['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'][r.dia_semana]}`,
    },
  })),
};
---
<!doctype html>
<html lang="es-CL">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
  <title>{tituloCompleto}</title>
  <meta name="description" content={descripcion} />
  <link rel="canonical" href={canonica} />
  {noindex && <meta name="robots" content="noindex, nofollow" />}
  <meta name="theme-color" content="#0C1D42" />
  <link rel="icon" href={ruta('/favicon.svg')} type="image/svg+xml" />
  <link rel="icon" href={ruta('/favicon-32.png')} sizes="32x32" type="image/png" />
  <link rel="apple-touch-icon" href={ruta('/apple-touch-icon.png')} />
  <link rel="manifest" href={ruta('/site.webmanifest')} />
  <link rel="preload" href={anton} as="font" type="font/woff2" crossorigin />
  <link rel="preload" href={montserrat} as="font" type="font/woff2" crossorigin />
  <meta property="og:type" content="website" />
  <meta property="og:locale" content="es_CL" />
  <meta property="og:site_name" content={iglesia.nombre.marca} />
  <meta property="og:title" content={tituloCompleto} />
  <meta property="og:description" content={descripcion} />
  <meta property="og:url" content={canonica} />
  <meta property="og:image" content={ogImagen} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta name="twitter:card" content="summary_large_image" />
  {ld && <script type="application/ld+json" set:html={JSON.stringify(ld)} />}
  <script is:inline>document.documentElement.classList.add('js')</script>
</head>
<body>
  <Header sobreNoche={sobreNoche} />
  <main id="contenido" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script type="application/json" id="datos-horario" set:html={JSON.stringify(datosHorario)} />
  <script>import '../lib/cliente';</script>
</body>
</html>
